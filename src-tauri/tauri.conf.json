{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kladje",
  "version": "0.1.0",
  "identifier": "app.kladje.editor",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "node scripts/build-diagrams.mjs",
    "beforeDevCommand": "node scripts/build-diagrams.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kladje",
        "width": 1240,
        "height": 800,
        "minWidth": 480,
        "minHeight": 320,
        "tabbingIdentifier": "app.kladje.documents",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: https:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright © 2026 Cyberdelia",
    "resources": {
      "../LICENSE": "licenses/LICENSE.txt",
      "THIRD-PARTY-NOTICES.txt": "licenses/THIRD-PARTY-NOTICES-RUST.txt",
      "../ui/vendor/THIRD-PARTY-NOTICES.txt": "licenses/THIRD-PARTY-NOTICES-FRONTEND.txt",
      "../ui/vendor/THIRD-PARTY-NOTICES-DIAGRAMS.txt": "licenses/THIRD-PARTY-NOTICES-DIAGRAMS.txt"
    },
    "macOS": { "signingIdentity": "-" },
    "shortDescription": "A light, fast Markdown editor",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ]
  }
}
